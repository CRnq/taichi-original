<div class="form-container">
  <h2>✈️ 新しい旅の登録</h2>
  
  <form action="/trip/new" method="post">
    
    <div class="form-group">
      <label for="trip_name">ルーム名</label>
      <input type="text" id="trip_name" name="trip_name" required>
    </div>
    
    <div class="form-group">
      <label for="flight_number">🔢 便名 (例: MM701)</label>
      <input type="text" id="flight_number" name="flight_number" required>
    </div>

    <div class="form-group">
      <label for="flight_date">📅 出発日</label>
      <input type="date" id="flight_date" name="flight_date" required>
    </div>

    <button type="submit" class="btn">🚀 ルームを作成する</button>
  </form>
</div>